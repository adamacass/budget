# ---------------------------------------------------------------------------
# Household budget app — self-hosting configuration.
#
#   cp .env.docker.example .env
#   (edit .env, then: docker compose up -d --build)
#
# .env is git-ignored. Never commit it.
# ---------------------------------------------------------------------------


# --- Required --------------------------------------------------------------

# Signs the login cookies/tokens. Any long random string will do.
# Generate one with:
#     openssl rand -base64 32
# On Windows PowerShell, if you have no openssl:
#     [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Max 256 }))
# Changing this later logs everyone out; it does not touch any data.
JWT_SECRET=


# --- Optional --------------------------------------------------------------

# Enables the Claude-powered features. Get one at https://console.anthropic.com
# Leave blank and the app still runs — see SELF-HOSTING.md for exactly which
# four features degrade (they return a "not configured" message, nothing breaks).
# This is billed per use, separately from any Claude subscription.
ANTHROPIC_API_KEY=

# Port on your desktop that the app is served on. http://localhost:8080
# Change it if something else already owns 8080.
APP_PORT=8080

# Cloudflare Tunnel token — only needed for remote access over a fixed https://
# address. Cloudflare Zero Trust dashboard -> Networks -> Tunnels -> Create a
# tunnel -> copy the token. Then start with:
#     docker compose --profile tunnel up -d
# Without --profile tunnel this is ignored entirely.
#
# Protect the hostname with Cloudflare Access before using this — it puts the
# app on the public internet. See SELF-HOSTING.md.
TUNNEL_TOKEN=


# --- Database --------------------------------------------------------------

# Postgres image for the local database. This must be the SAME major version as,
# or newer than, the server you are migrating from — pg_dump will not read a
# server newer than itself. Render currently provisions Postgres 18.
# Check your source with:  SELECT version();
# Changing this later means deleting the budget-db-data volume and restoring again.
POSTGRES_IMAGE=postgres:18-alpine
# These three create the Postgres user/database on FIRST start only. Once the
# budget-db-data volume exists, changing them here does not change the database —
# you would have to delete the volume (and your data) for that to take effect.
POSTGRES_USER=budget
POSTGRES_PASSWORD=budget
POSTGRES_DB=budget

# How the app reaches Postgres. Must match the three values above.
#
# Keep the ?sslmode=disable on the end. The Postgres container speaks no TLS, and
# without it the client can end up demanding TLS and failing with
# "The server does not support SSL connections". server/db.js honours it, and so
# does the node-postgres driver independently, so it holds either way.
#
# Postgres is not reachable from outside the compose network, so a weak password
# here is acceptable — but change it if you uncomment the db ports mapping.
DATABASE_URL=postgresql://budget:budget@db:5432/budget?sslmode=disable


# --- Migrating off Render (optional, used by scripts/migrate-from-render.sh) --
# Render dashboard -> your Postgres instance -> Connections -> "External Database URL".
# You can also pass it as an argument to the script instead of storing it here.
# RENDER_DATABASE_URL=postgresql://user:password@dpg-xxxx.oregon-postgres.render.com/dbname
